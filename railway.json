{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bash build.sh"
  },
  "deploy": {
    "startCommand": "daphne -b 0.0.0.0 -p $PORT airbnb_manager.asgi:application",
    "preDeployCommand": "python manage.py migrate --no-input"
  }
}
